# All VITE_ variables are PUBLIC: they are bundled into the browser build.
# Never put private keys, seed phrases, API secrets or server tokens here.

# Default network shown in the UI: "testnet" or "mainnet". Defaults to testnet.
VITE_DEFAULT_NETWORK=testnet

# Optional RPC override for read-only calls (not used for transactions in Stage 1).
VITE_MEZO_TESTNET_RPC=https://rpc.test.mezo.org
