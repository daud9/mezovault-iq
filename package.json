    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "4.17.25",
    "@types/node": "22.18.12",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
