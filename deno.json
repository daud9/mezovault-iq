{
  "tasks": {
    "build": "npm run build",
    "start": "deno run --allow-net --allow-read --allow-env --node-modules-dir=auto server/main.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": { "lib": ["deno.window", "dom"] },
  "deploy": {
    "install": "npm install",
    "build": "npm run build",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./server/main.ts"
    }
  }
}
